@model IEnumerable<FoodWasteManager.Models.Application>
@using System.Security.Claims

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var rawViewType = Context.Request.Query["viewType"].ToString()?.ToLower();
    var validTypes = new[] { "applicationsmade", "applicationsreceived" };
    var viewType = validTypes.Contains(rawViewType) ? rawViewType : "applicationsmade";  // default

    var currentFilter = ViewData["CurrentFilter"] as string ?? "";
    var currentSort = ViewData["CurrentSort"] as string ?? "";
    var currentPage = (int?)(ViewBag.CurrentPage) ?? 1;
    var totalPages = (int?)(ViewBag.TotalPages) ?? 1;

    var filteredApps = Model;

    if (!User.IsInRole("Admin"))
    {
        filteredApps = viewType switch
        {
            "applicationsmade" => Model.Where(a => a.UserId == currentUserId),
            "applicationsreceived" => Model.Where(a => a.FoodPost.UserId == currentUserId),
            _ => Enumerable.Empty<FoodWasteManager.Models.Application>()
        };
    }
}

<h1 style="color:#3d5438">
    @if (User.IsInRole("Admin"))
    {
        <text>All Applications:</text>
    }
    else if (viewType == "applicationsmade")
    {
        <text>Applications Made:</text>
    }
    else if (viewType == "applicationsreceived")
    {
        <text>Applications Received:</text>
    }
    else
    {
        <text>Invalid View Type</text>
    }
</h1>

<form asp-action="Index" method="get" class="d-inline-flex align-items-center gap-2 mb-3 flex-wrap">
    <input type="hidden" name="viewType" value="@viewType" />
    <input type="hidden" name="sortOrder" value="@currentSort" />
    <input type="text" name="searchString" value="@currentFilter" placeholder="Search applications..." class="form-control form-control-sm" style="min-width: 250px;" />
    <button type="submit" class="btn btn-sm apply-btn">Search</button>
    <a asp-action="Index" asp-route-viewType="@viewType" class="btn btn-sm apply-btn">Clear</a>

    <span class="text-muted ms-3 me-2">Sort by:</span>
    @{
        var sortOptions = new[]
        {
            new { Text = "Status ↑", Value = "status" },
            new { Text = "Status ↓", Value = "status_desc" },
            new { Text = "Food Name ↑", Value = "foodname" },
            new { Text = "Food Name ↓", Value = "foodname_desc" }
        };
    }
    @foreach (var option in sortOptions)
    {
        var activeClass = currentSort == option.Value ? "active" : "";
            <a asp-action="Index" asp-route-viewType="@viewType" asp-route-sortOrder="@option.Value" asp-route-searchString="@currentFilter"
               class="btn btn-sm apply-btn @activeClass">@option.Text</a>
    }
</form>

@if (!filteredApps.Any())
{
        <div class="alert alert-info">
        @if (viewType == "applicationsmade")
        {
            <text>You haven't made any applications yet.</text>
        }
        else if (viewType == "applicationsreceived")
        {
            <text>No applications found.</text>
        }
        else
        {
            <text>Invalid view type.</text>
        }
        </div>
}
else if (viewType == "applicationsmade")
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
        @foreach (var item in filteredApps)
        {
            <div class="col">
                <div class="card shadow rounded-5 d-flex flex-column" style="aspect-ratio:1/1; background:#f0ede6;">
                    <div style="height:50%; overflow:hidden;">
                        <img src="@Url.Content(item.FoodPost.FoodImage)" alt="@item.FoodPost.FoodName" class="w-100 h-100" style="object-fit:cover;" />
                    </div>
                    <div class="card-body d-flex flex-column p-2">
                        <h6 class="card-title mb-1">@item.FoodPost.FoodName</h6>
                        <p class="mb-0 small">Qty: @item.QuantityRequired</p>
                        <p class="mb-0 small">
                            Status:
                            @switch (item.AStatus)
                            {
                                case Application.ApplicationStatus.Approved:
                                    <span class="badge badge-approved">@item.AStatus</span>
                                    break;
                                case Application.ApplicationStatus.Processing:
                                    <span class="badge bg-warning text-dark">@item.AStatus</span>
                                    break;
                                case Application.ApplicationStatus.Declined:
                                    <span class="badge badge-declined">@item.AStatus</span>
                                    break;
                            }
                        </p>

                        @if (item.AStatus == Application.ApplicationStatus.Approved)
                        {
                            <p class="mb-0 small">Pickup: @item.EarliestPickup.ToShortDateString() - @item.LatestPickup.ToShortDateString()</p>
                        }

                        <div class="mt-auto d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@item.ApplicationId" class="btn btn-sm apply-btn" title="Details">
                                <i class="bi bi-info-circle-fill"></i>
                            </a>

                            @if (item.AStatus == Application.ApplicationStatus.Approved && !User.IsInRole("Admin"))
                            {
                                <form asp-action="Payment" asp-controller="FoodPosts" method="get" class="m-0 p-0">
                                    <input type="hidden" name="ApplicationId" value="@item.ApplicationId" />
                                    <button type="submit" class="btn btn-sm btn-paynow">Pay Now</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

}
else if (viewType == "applicationsreceived")
{
    var groups = new[]
    {
        new { Title = "Pending Applications", Status = Application.ApplicationStatus.Processing, Id = "pending" },
        new { Title = "Approved Applications", Status = Application.ApplicationStatus.Approved, Id = "approved" },
        new { Title = "Declined Applications", Status = Application.ApplicationStatus.Declined, Id = "declined" }
    };

        <div class="accordion" id="receivedAccordion">
        @foreach (var group in groups)
        {
            var groupApps = filteredApps.Where(a => a.AStatus == group.Status);
            var collapseId = $"{group.Id}Collapse";
            var headingId = $"{group.Id}Heading";
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed group-accordion-btn" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                        @group.Title
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId">
                            <div class="accordion-body">
                        @if (!groupApps.Any())
                        {
                                        <div class="alert alert-info mt-3">No @group.Title.ToLower().Replace("applications", "").Trim() applications found.</div>
                        }
                        else
                        {
                                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                                @foreach (var item in groupApps)
                                {
                                                    <div class="col">
                                                        <div class="card shadow rounded-5 d-flex flex-column" style="aspect-ratio:1/1; background:#f0ede6;">
                                                            <div style="height:50%; overflow:hidden;">
                                                                <img src="@Url.Content(item.FoodPost.FoodImage)" alt="@item.FoodPost.FoodName" class="w-100 h-100" style="object-fit:cover;" />
                                                            </div>
                                                            <div class="card-body d-flex flex-column p-2">
                                                                <h6 class="card-title mb-1">@item.FoodPost.FoodName</h6>
                                                                <p class="mb-0 small">Qty: @item.QuantityRequired</p>
                                                                <p class="mb-0 small">
                                                                    Status:
                                                    @switch (item.AStatus)
                                                    {
                                                        case Application.ApplicationStatus.Approved:
                                                                                    <span class="badge badge-approved">@item.AStatus</span>
                                                            break;
                                                        case Application.ApplicationStatus.Processing:
                                                                                    <span class="badge bg-warning text-dark">@item.AStatus</span>
                                                            break;
                                                        case Application.ApplicationStatus.Declined:
                                                                                    <span class="badge badge-declined">@item.AStatus</span>
                                                            break;
                                                    }
                                                                </p>
                                                @if (item.AStatus == Application.ApplicationStatus.Approved)
                                                {
                                                                        <p class="mb-0 small">Pickup: @item.EarliestPickup.ToShortDateString() - @item.LatestPickup.ToShortDateString()</p>
                                                }
                                                @if (item.AStatus == Application.ApplicationStatus.Processing)
                                                {
                                                                        <div class="mt-auto d-flex justify-content-between flex-wrap">
                                                                            <form method="post" asp-action="Approve" asp-route-id="@item.ApplicationId" class="d-inline">
                                                                                <button type="submit" class="btn btn-sm btn-pending me-1" title="Approve">
                                                                                    <i class="bi bi-check-circle-fill"></i>
                                                                                </button>
                                                                            </form>
                                                                            <form method="post" asp-action="Decline" asp-route-id="@item.ApplicationId" class="d-inline">
                                                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Reject">
                                                                                    <i class="bi bi-x-circle-fill"></i>
                                                                                </button>
                                                                            </form>
                                                                        </div>
                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                }
                                        </div>
                        }
                            </div>
                        </div>
                    </div>
        }
        </div>
}
<div class="pagination mt-5" style="font-size: 1.25rem;">
    <span class="ms-3">Page @currentPage of @totalPages</span>

    @if (currentPage > 1)
    {
        <h5 >
            <a class="apply-btn ms-3" style="font-size: 1.25rem" asp-action="Index"
               asp-route-viewType="@viewType"
               asp-route-sortOrder="@currentSort"
               asp-route-searchString="@currentFilter"
               asp-route-pageNumber="@(currentPage - 1)">
                Previous Page
            </a>
        </h5>
    }

    @if (currentPage < totalPages && !User.IsInRole("Seller")) 
    {
        <h5 >
            <a class="apply-btn ms-3" style="font-size: 1.25rem" asp-action="Index"
               asp-route-viewType="@viewType"
               asp-route-sortOrder="@currentSort"
               asp-route-searchString="@currentFilter"
               asp-route-pageNumber="@(currentPage + 1)">
                Next Page
            </a>
        </h5>
    }
</div>


<style>
    body, .card {
        background-color: #f0ede6;
    }

    .apply-btn {
        color: #3d5438;
        border: 1px solid #3d5438;
        text-decoration: none;
        padding: 3px 10px;
        border-radius: 4px;
        transition: all 0.3s ease;
        background-color: #d0f2b6;
    }

    .apply-btn:hover {
        background-color: #3d5438;
        color: white;
        border-color: #3d5438;
    }

    .clear-btn {
        padding: 3px 10px;
        border-radius: 4px;
    }

    .apply-btn {
        color: #3d5438;
        border: 1px solid #3d5438;
        text-decoration: none;
        padding: 4px 12px;
        border-radius: 4px;
        transition: all 0.3s ease;
        background-color: transparent;
        font-size: 0.9rem;
        display: inline-block;
    }

    .apply-btn:hover,
    .apply-btn.active {
            background-color: #3d5438;
        color: #FFF;
        border-color: #3d5438;
        border: 1px solid #fff
    }

    .btn-pending {
        background-color: #f0ede6;
        color: #3d5438;
        border: 1px solid #3d5438;
        padding: 4px 10px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

    .btn-pending:hover {
        background-color: #b7d897;
        color: #2b3d28;
    }

    .btn-outline-danger {
        color: #dc3545;
        border-color: #dc3545;
        padding: 3px 10px;
        border-radius: 4px;
        transition: all 0.3s ease;
        background-color: transparent;
        display: inline-block;
    }

    .btn-outline-danger:hover {
        background-color: #dc3545;
        color: white;
    }

    .card {
        background-color: #f0ede6;
        box-shadow: 0 2px 5px rgba(61, 84, 56, 0.2);
    }

    .card-title {
        font-weight: 600;
        color: #3d5438;
    }

    .badge {
        font-weight: 600;
        padding: 0.35em 0.65em;
        border-radius: 0.375rem;
        font-size: 0.85rem;
    }

    .badge-approved {
        background-color: #3d5438;
        color: white;
    }

    .badge-declined {
        background-color: #dc3545;
        color: white;
    }

    h1 {
        color: #3d5438;
    }

    .group-accordion-btn {
        background-color: #3d5438;
        color: #d0f2b6;
        border: none;
        box-shadow: none;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

    .group-accordion-btn::after {
        filter: invert(1);
    }

    .group-accordion-btn:hover,
    .group-accordion-btn:focus {
        background-color: #33502e;
        color: #c6e3a9;
        outline: none;
    }

    .group-accordion-btn:not(.collapsed) {
        background-color: #3d5438 !important;
        color: #d0f2b6 !important;
        box-shadow: none !important;
    }

    .btn-paynow {
        background-color: #d0f2b6; /* spinach green */
        color: black;
        border: 1px solid #3d5438;
        padding: 4px 10px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

        .btn-paynow:hover {
            background-color: #3d5438; /* darker spinach */
            color: white;
        }

</style>
