@model FoodWasteManager.Models.Application

@{
    ViewData["Title"] = "Apply for Food";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-start" style="min-height: 80vh; background-color: #f0ede6; padding: 2rem;">
    <div class="w-100" style="max-width: 600px;">
        <h1 class="mb-4 text-center" style="color:#3d5438;">Apply for a Food Post</h1>

        <form asp-action="Create" onsubmit="return validatePickupDates();" class="p-4 rounded-4 shadow" style="background-color:#d0f2b6;">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3" >
                
                <input type="hidden" asp-for="FoodPostId" />
            </div>

            <div class="mb-3">
                <label asp-for="QuantityRequired" class="form-label fw-semibold" style="color:#3d5438;">Quantity Required</label>
                <input asp-for="QuantityRequired" class="form-control" />
                <span asp-validation-for="QuantityRequired" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EarliestPickup" class="form-label fw-semibold" style="color:#3d5438;">Earliest Pickup</label>
                <input asp-for="EarliestPickup" id="EarliestPickup" type="datetime-local" class="form-control" />
                <span asp-validation-for="EarliestPickup" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LatestPickup" class="form-label fw-semibold" style="color:#3d5438;">Latest Pickup</label>
                <input asp-for="LatestPickup" id="LatestPickup" type="datetime-local" class="form-control" />
                <span asp-validation-for="LatestPickup" class="text-danger"></span>
            </div>

            <div id="pickup-error" class="text-danger mb-3 fw-semibold" style="display:none;"></div>

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-success fw-semibold" style="background-color:#3d5438; border:none; min-width:120px;">
                    <i class="bi bi-check-circle-fill me-2"></i> Submit
                </button>
                <a asp-action="Index" asp-controller="FoodPosts" class="btn apply-btn ms-2" style="min-width:120px;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationScriptsPartial")

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const earliestInput = document.getElementById("EarliestPickup");
            const latestInput = document.getElementById("LatestPickup");

            const now = new Date();
            const minEarliest = now.toISOString().slice(0, 16);
            const maxEarliestDate = new Date(now);
            maxEarliestDate.setDate(now.getDate() + 3);
            const maxEarliest = maxEarliestDate.toISOString().slice(0, 16);

            // Set initial min/max for EarliestPickup (next 3 days)
            earliestInput.min = minEarliest;
            earliestInput.max = maxEarliest;

            // When EarliestPickup is chosen
            earliestInput.addEventListener("change", function () {
                const earliestDate = new Date(earliestInput.value);

                if (!earliestInput.value) {
                    latestInput.min = "";
                    latestInput.max = "";
                    return;
                }

                const minLatestDate = new Date(earliestDate);
                const maxLatestDate = new Date(earliestDate);
                maxLatestDate.setDate(earliestDate.getDate() + 2);

                const minLatest = minLatestDate.toISOString().slice(0, 16);
                const maxLatest = maxLatestDate.toISOString().slice(0, 16);

                // Apply min/max to LatestPickup
                latestInput.min = minLatest;
                latestInput.max = maxLatest;

                // Reset LatestPickup if out of bounds
                if (latestInput.value) {
                    const latestDate = new Date(latestInput.value);
                    if (latestDate < minLatestDate || latestDate > maxLatestDate) {
                        alert("Latest Pickup must be within 2 days after the Earliest Pickup.");
                        latestInput.value = "";
                    }
                }
            });
        });

        function validatePickupDates() {
            const earliestInput = document.getElementById("EarliestPickup").value;
            const latestInput = document.getElementById("LatestPickup").value;
            const errorDiv = document.getElementById("pickup-error");
            errorDiv.style.display = "none";
            errorDiv.innerText = "";

            if (!earliestInput || !latestInput) return true;

            const earliest = new Date(earliestInput);
            const latest = new Date(latestInput);
            const now = new Date();

            const maxEarliest = new Date();
            maxEarliest.setDate(now.getDate() + 3);

            if (earliest < now || earliest > maxEarliest) {
                errorDiv.innerText = "Earliest Pickup must be within the next 3 days.";
                errorDiv.style.display = "block";
                return false;
            }

            const maxLatest = new Date(earliest);
            maxLatest.setDate(earliest.getDate() + 2);

            if (latest < earliest || latest > maxLatest) {
                errorDiv.innerText = "Latest Pickup must be within 2 days after the Earliest Pickup.";
                errorDiv.style.display = "block";
                return false;
            }

            return true;
        }
    </script>
}


                <style>
    .apply-btn {
        color: #3d5438;
        border: 1px solid #3d5438;
        text-decoration: none;
        padding: 4px 12px;
        border-radius: 4px;
        transition: all 0.3s ease;
        background-color: transparent;
        font-size: 0.9rem;
        display: inline-block;
    }

        .apply-btn:hover,
        .apply-btn.active {
            background-color: #3d5438;
            color: #FFF;
            border-color: #3d5438;
            border: 1px solid #fff
        }



                </style>