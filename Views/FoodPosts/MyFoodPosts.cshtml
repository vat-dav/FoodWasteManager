@model IEnumerable<FoodWasteManager.Models.FoodPost>
@using FoodWasteManager.Areas.Identity.Data
@using FoodWasteManager.Models
@inject Microsoft.AspNetCore.Identity.UserManager<FoodWasteManagerUser> UserManager

@{
    ViewData["Title"] = "My Food Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentUserId = UserManager.GetUserId(User);
}

<h1 style="color:#3d5438">Edit Your Food Posts:</h1>

<div class="row g-3 justify-content-center mt-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <h2 class="text-muted text-center">No relevant food posts found!</h2>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            if (item.FoodQuantity > 0 && item.UserId == currentUserId)
            {
                <div class="col-6 col-sm-4 col-md-3 d-flex justify-content-center">
                    <div class="card shadow rounded-5 d-flex flex-column food-card" style="aspect-ratio:1/1; background:#fff;">

                        <div style="height: 50%; overflow: hidden;">
                            <img src="@Url.Content(item.FoodImage)" alt="@item.FoodName" class="w-100 h-100" style="object-fit:cover;" />
                        </div>

          
                        <div class="card-body d-flex flex-column p-2 flex-grow-1">
                            <h6 class="card-title mb-1">@item.FoodName</h6>
                            <h3 class="mb-0 small">Qty: @item.FoodQuantity</h3>
                            <h3 class="mb-0 small">Price: $@item.FoodPrice</h3>
                            <h4 class="mb-2 small">Best Before: @item.FoodBestBefore.ToShortDateString()</h4>
                            <div class="mt-auto d-flex justify-content-center gap-2">
                                <a asp-action="Edit" asp-route-id="@item.FoodPostId"
                                   class="btn apply-btn fw-semibold" style="min-width:140px;">
                                    <p class="mt-sm-1"> <i class="bi bi-pencil-square me-2 mt-2"></i> Edit</p>
                                </a>                                
                              <a asp-action="Delete" asp-route-id="@item.FoodPostId"
                                   class="btn btn-outline-danger fw-semibold" style="min-width:140px;">
                                    Delete <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        </div>


                    </div>
                </div>
            }
        }
    }
</div>

<style>
    .apply-btn {
        color: #3d5438;
        border: 1px solid #3d5438;
        text-decoration: none;
        padding: 3px 10px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

        .apply-btn:hover {
            background-color: #3d5438;
            color: white;
            border-color: #3d5438;
        }

    .card {
        background-color: #ffffff;
        min-height: 300px;
        box-shadow: 0 2px 5px rgba(61, 84, 56, 0.2);
    }

    .card-title {
        font-weight: 600;
        color: #3d5438;
    }
</style>
