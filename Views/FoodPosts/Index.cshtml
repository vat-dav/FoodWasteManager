@model IEnumerable<FoodWasteManager.Models.FoodPost>
@using Azure.Core
@using FoodWasteManager.Models;

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    
    var sortOrder = Context.Request.Query["sortOrder"].ToString();

    var isBuyer = User.IsInRole("Buyer");
    var isSeller = User.IsInRole("Seller");
    var isAdmin = User.IsInRole("Admin");

    var hasNoRole = !isBuyer && !isSeller && !isAdmin;
}




<div class="justify-content-end">
  
    <h1 style="color:#3d5438">FoodPosts Made:</h1>



    @if (isBuyer || isSeller || !isAdmin || hasNoRole)
        {
            <div class="mt-3">
                <a asp-action="Create" class="btn align-content-center" style="background-color:#d0f2b6">
                    <h6 style="color:#3d5438">Create New</h6>
                </a>
            </div>

        }

<div class="d-flex flex-wrap align-items-center mt-3 gap-2">
    <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
        <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search food..."
               class="form-control form-control-sm" style="width: 200px; border-color: #3d5438;" />
        <button type="submit" class="btn btn-sm apply-btn">Search</button>
        <a asp-action="Index" class="btn btn-sm apply-btn" style="border-color:#3d5438;">Clear</a>
    </form>

    <span class="ms-3 me-2 text-muted">Sort by:</span>

    @if (User.IsInRole("Buyer") || User.IsInRole("Seller") || hasNoRole)
    {
        <a asp-action="Index" asp-route-sortOrder="date"
           class="btn btn-sm apply-btn @(sortOrder == "date" ? "active" : "")">Best Before ↑</a>
        <a asp-action="Index" asp-route-sortOrder="date_desc"
           class="btn btn-sm apply-btn @(sortOrder == "date_desc" ? "active" : "")">Best Before ↓</a>

        <a asp-action="Index" asp-route-sortOrder="price"
           class="btn btn-sm apply-btn @(sortOrder == "price" ? "active" : "")">Low to High Price</a>
        <a asp-action="Index" asp-route-sortOrder="price_desc"
           class="btn btn-sm apply-btn @(sortOrder == "price_desc" ? "active" : "")">High to Low Price</a>
    }

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Index" asp-route-sortOrder="dateposted" class="btn btn-sm apply-btn @(sortOrder == "dateposted" ? "active" : "")">Oldest</a>
        <a asp-action="Index" asp-route-sortOrder="dateposted_desc" class="btn btn-sm apply-btn @(sortOrder == "dateposted_desc" ? "active" : "")">Newest</a>
    }
</div>





   <div class="row g-3 justify-content-center mt-3">
        @if (!Model.Any())
        {
            <div>
                <h2 class="text-muted text-center">No relevant food posts found!</h2>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                if (item.FoodQuantity > 0)
                { // Only makes cards for the foodpost if the foodquantity is more than 0
   <div class="col-6 col-sm-4 col-md-3 d-flex justify-content-center">
                        <div class="card shadow rounded-5 d-flex flex-column food-card" style="aspect-ratio:1/1; background:#fff;">



                <div style="height: 50%; overflow: hidden;">
                    <img src="@Url.Content(item.FoodImage)" alt="@item.FoodName" class="w-100 h-100" style="object-fit: cover;" />
                </div>
                <div class="card-body d-flex flex-column p-2" style="overflow: hidden;">
                    <h6 class="card-title mb-1">@item.FoodName</h6>
                    <h3 class="mb-0 small">Qty: @item.FoodQuantity</h3>
                    <h3 class="mb-0 small">Price: $@item.FoodPrice</h3>
                    <h4 class="mb-2 small">Best Before: @item.FoodBestBefore.ToShortDateString()</h4>
                    <div class="mt-auto d-flex justify-content-between">
                        <a asp-controller="Applications" asp-action="Create" asp-route-FoodPostId="@item.FoodPostId" class="btn btn-sm apply-btn" style="outline-color:#3d5438">Apply!</a>
                        <a asp-action="Details" asp-route-id="@item.FoodPostId" class="btn btn-sm apply-btn">Details</a>
                        @{
                            if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@item.FoodPostId" class="btn btn-sm btn-outline-danger">Delete
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    }
    }
    }
    
    </div>

<div class="pagination mt-5">
   

    <span class="ms-3">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>

     @if (ViewBag.CurrentPage > 1)
    {
        <h5> <a class="apply-btn ms-3" asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(ViewBag.CurrentPage - 1)">Previous Page</a></h5>
    }

    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
    {
        <h5> <a class="apply-btn ms-3" asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-currentFilter="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(ViewBag.CurrentPage + 1)">Next Page</a> </h5>
    }
</div>


<style>


      .apply-btn {
        color: #3d5438;
        border: 1px solid #3d5438;
        text-decoration: none;
        padding: 3px 10px;
        border-radius: 4px;
        transition: all 0.3s ease;
    }

        .apply-btn:hover {
            background-color: #3d5438;
            color: white;
          border-color: #3d5438;
        }

        .clear-btn{
        padding: 3px 10px;
        border-radius: 4px;

        }

    .card {
        background-color: #ffffff;
        min-height: 300px;
        box-shadow: 0 2px 5px rgba(61, 84, 56, 0.2);
    }

    .card-title {
        font-weight: 600;
        color: #3d5438;
    }
        
        </style>